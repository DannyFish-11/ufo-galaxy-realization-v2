      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "increase(galaxy_slo_reconnect_attempts_total[5m])",
          "legendFormat": "Reconnects / 5m",
          "refId": "A"
        }
