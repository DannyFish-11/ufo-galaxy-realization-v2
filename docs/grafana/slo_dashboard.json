  "refresh": "30s",
  "schemaVersion": 37,
  "style": "dark",
  "tags": ["galaxy", "slo", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Galaxy SLO Dashboard",
  "uid": "galaxy-slo-v1",
  "version": 1
