      "title": "Command Latency Percentiles",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "galaxy_slo_command_latency_p50_ms",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "galaxy_slo_command_latency_p95_ms",
          "legendFormat": "p95",
          "refId": "B"
        }
      ]
