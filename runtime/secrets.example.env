# runtime/secrets.example.env — copy to runtime/secrets.env and fill in your real keys.
#
# IMPORTANT: This file contains ONLY secrets (API keys, tokens, passwords).
#   - DO NOT commit runtime/secrets.env to git (it is in .gitignore).
#   - Non-secret configuration belongs in runtime/config.json, NOT here.
#   - Values set here may be overridden by environment variables of the same name.
#
# Format: KEY=value (no quotes needed, shell-style comments with # are supported)

# ── LLM Provider API Keys (2026-05-29: 14 providers) ──────────────────────
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Chinese Providers (2026-05-29新增) ─────────────────────────────────────
QWEN_API_KEY=your_qwen_api_key_here        # 阿里云DashScope / Qwen 3.7 Max
ZHIPU_API_KEY=your_zhipu_api_key_here      # 智谱AI / GLM-5.1
MINIMAX_API_KEY=your_minimax_api_key_here  # MiniMax / M2.7 (2026-03-18)
STEP_API_KEY=your_step_api_key_here        # 阶跃星辰 / Step 3.7 Flash (2026-05-29)
MIMO_API_KEY=your_mimo_api_key_here        # 小米 / MiMo V2.5 Pro (2026-04-22)

# ── OneAPI (aggregator) ────────────────────────────────────────────────────
ONEAPI_API_KEY=your_oneapi_api_key_here

# ── Galaxy Runtime Auth ────────────────────────────────────────────────────
GALAXY_API_TOKEN=your_galaxy_api_token_here
