[Unit]
Description=UFO Galaxy AI System
Documentation=https://github.com/DannyFish-11/galaxy-realization
After=network.target
Wants=network.target

[Service]
Type=simple
User=%I
Group=%I
WorkingDirectory=/opt/ufo-galaxy

# Environment
Environment="PYTHONPATH=/opt/ufo-galaxy"
Environment="GALAXY_HOME=/opt/ufo-galaxy"
Environment="GALAXY_LOG_LEVEL=INFO"
Environment="GALAXY_MODE=production"
Environment="USE_LOCAL_BRAIN_FIRST=true"

# Main executable
# 注意:main.py 的 argparse 不认识 --gpu-opt / --persistent-models(旧参数)。
# 传了会 exit 2,叠加 Restart=always 变成 10 秒一次的无限重启环。
ExecStart=/usr/bin/python3 -m main

# PR-D4: Automatic restart configuration (always-on)
Restart=always
RestartSec=10
StartLimitInterval=0

# Graceful shutdown
TimeoutStopSec=30
KillSignal=SIGTERM

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=galaxy

[Install]
WantedBy=multi-user.target
