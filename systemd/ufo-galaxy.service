[Unit]
Description=UFO Galaxy AI System
Documentation=https://github.com/DannyFish-11/galaxy-realization
After=network.target
Wants=network.target

[Service]
Type=simple
User=%I
Group=%I
WorkingDirectory=/opt/ufo-galaxy

# Environment
Environment="PYTHONPATH=/opt/ufo-galaxy"
Environment="GALAXY_HOME=/opt/ufo-galaxy"
Environment="GALAXY_LOG_LEVEL=INFO"
Environment="GALAXY_MODE=production"
Environment="USE_LOCAL_BRAIN_FIRST=true"

# Main executable
ExecStart=/usr/bin/python3 -m main --gpu-opt --persistent-models all

# PR-D4: Automatic restart configuration (always-on)
Restart=always
RestartSec=10
StartLimitInterval=0

# Graceful shutdown
TimeoutStopSec=30
KillSignal=SIGTERM

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=galaxy

[Install]
WantedBy=multi-user.target
