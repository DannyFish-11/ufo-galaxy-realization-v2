[Unit]
Description=Galaxy Health Monitor
After=galaxy.service
Wants=galaxy.service

[Service]
Type=simple
User=galaxy
Group=galaxy
WorkingDirectory=/opt/galaxy

ExecStart=/opt/galaxy/venv/bin/python -m health_monitor --watchdog --interval 30

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=galaxy-health

[Install]
WantedBy=multi-user.target
