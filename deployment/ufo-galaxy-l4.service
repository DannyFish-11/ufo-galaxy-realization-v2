[Unit]
Description=Galaxy L4 Autonomous Intelligence System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/galaxy-realization-v2
EnvironmentFile=/home/ubuntu/galaxy-realization-v2/.env
Environment=PYTHONPATH=/home/ubuntu/galaxy-realization-v2
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/ubuntu/galaxy-realization-v2/unified_launcher.py --host 0.0.0.0 --port 8080
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=galaxy-l4

[Install]
WantedBy=multi-user.target
