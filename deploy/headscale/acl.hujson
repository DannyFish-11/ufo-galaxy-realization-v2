// Galaxy tailnet 的访问规则(可选)。
//
// 默认 config.yaml 里没启用它:不配规则 = tailnet 里的设备可以互相访问。
// 这里全是你自己的设备,这正是想要的。
//
// 什么时候需要:比如想让手表只能访问网关的 9000 端口、别的什么都碰不到。
// 启用:把 config.yaml 末尾的 policy 两行取消注释,然后 docker compose restart。
// 用户名的写法是 "<用户>@"(headscale 0.26 起的格式),与 init.sh 建的 galaxy 用户对应。
{
  "tagOwners": {
    "tag:gateway": ["galaxy@"],
    "tag:watch": ["galaxy@"],
  },

  "acls": [
    // 默认:互通。要收紧时删掉这一条,改用下面注释里的那几条。
    { "action": "accept", "src": ["*"], "dst": ["*:*"] },

    // 收紧示例:同一用户的设备互通,但带 tag:watch 的只能访问网关的 9000 端口。
    // { "action": "accept", "src": ["galaxy@"], "dst": ["galaxy@:*"] },
    // { "action": "accept", "src": ["tag:watch"], "dst": ["tag:gateway:9000"] },
  ],
}
