// ACL Policy — Galaxy Tailnet
// Open policy: all devices can communicate with each other
// Production: restrict by tags for security
{
  // Host definitions (static IPs)
  "hosts": {
    "gateway": "100.64.0.1/32",
    "watch-001": "100.64.0.10/32",
    "android-001": "100.64.0.20/32"
  },

  // Tag definitions
  "tagOwners": {
    "tag:gateway": ["galaxy-admin"],
    "tag:watch": ["galaxy-admin"],
    "tag:phone": ["galaxy-admin"],
    "tag:desktop": ["galaxy-admin"]
  },

  // Access control: allow all tailnet devices to communicate
  "acls": [
    {
      "action": "accept",
      "src": ["*"],
      "dst": ["*:*"]
    }
  ],

  // SSH policy (Tailscale SSH)
  "ssh": [
    {
      "action": "accept",
      "src": ["tag:desktop"],
      "dst": ["tag:gateway"],
      "users": ["galaxy"]
    }
  ]

  // ── PR-PEER-RELAY: 对等中继限流（默认注释，避免旧版 Headscale 不识别 relays 键而拒整份 ACL）──
  // 当你的控制端（官方 Tailscale，或较新支持 Peer Relay 的 Headscale）就绪后，取消下面注释并把
  // 上一行 "ssh": [...] 后补一个逗号即可启用：只许你自己的手表/手机借道网关中继，防别人占带宽。
  //
  // "relays": [
  //   {
  //     "relay": "gateway",
  //     "accept": ["tag:watch", "tag:phone", "tag:desktop"]
  //   }
  // ]

  // ── 远程桌面(VNC)兜底接管：只许白名单设备访问网关的 5900 端口 ──
  // 上面 "acls" 是开放策略(* → *);若要收紧成"只有我的手机/桌面能 VNC 进网关",把下面
  // 这条加进 "acls" 数组(并确保数组各项间有逗号)。这样兜底接管口被 ACL 锁死、绝不外泄。
  //
  // {
  //   "action": "accept",
  //   "src": ["tag:phone", "tag:desktop"],
  //   "dst": ["tag:gateway:5900"]
  // }
}
