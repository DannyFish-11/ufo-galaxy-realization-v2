# ============================================================================
# Galaxy Docker Ignore — Exclude sensitive files from build context
# ============================================================================

# Environment / Secrets
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
config/secrets/

# Version control
.git/
.gitignore
.gitattributes
.svn/
.hg/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs and data
logs/
*.log
data/
*.db
*.sqlite
*.sqlite3

# Docker itself
Dockerfile*
.dockerignore
docker-compose*.yml
docker-compose*.yaml

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Documentation (not needed in image)
*.md
docs/

# Test files
tests/
test/
*_test.py
*_tests.py
pytest.ini
tox.ini
.coverage
htmlcov/

# Installer output
installer/
installer_output/
*.iss

# Assets not needed at runtime
assets/
