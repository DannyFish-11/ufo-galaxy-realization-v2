# Home Assistant Integration Environment Variables
# Copy to .env and fill in your values

# Home Assistant instance URL (local or remote)
HOME_ASSISTANT_URL=http://homeassistant.local:8123

# Long-lived access token (create in HA: Profile → Long-Lived Access Tokens)
HOME_ASSISTANT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxx

# Optional: Room/area mapping for spatial commands
# Format: GALAXY_ROOM_<alias>=<HA_area_id>
GALAXY_ROOM_LIVING=living_room
GALAXY_ROOM_BEDROOM=bedroom
GALAXY_ROOM_KITCHEN=kitchen
GALAXY_ROOM_OFFICE=office
