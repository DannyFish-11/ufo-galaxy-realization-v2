# EditorConfig for UFO Galaxy V2
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = 80

[*.{js,ts,jsx,tsx}]
indent_size = 2
quote_type = double

[*.py]
# Python: follow PEP 8
indent_size = 4
quote_type = double
