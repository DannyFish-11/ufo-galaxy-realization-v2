# Galaxy — Environment Variables
# Copy to .env and fill in your actual values:  cp .env.example .env

# ============================================================================
# System Mode & Fabric Configuration  (canonical config contract)
# ============================================================================
#
# GALAXY_SYSTEM_MODE controls whether the system starts in desktop-local
# (clone-first, no cross-device fabric required) or desktop-cross-device
# (explicit cross-device fabric, NATS/control-plane available) mode.
#
# desktop-local         — default after clone; NATS not required; startup
#                         proceeds even when NATS or fabric is unavailable.
# desktop-cross-device  — opt-in; cross-device fabric is active; NATS and
#                         control-plane are used; set GALAXY_FABRIC_STRICT=true
#                         to hard-fail on missing fabric dependencies.
#
GALAXY_SYSTEM_MODE=desktop-local          # desktop-local | desktop-cross-device

# NATS control-plane bus.
# When GALAXY_SYSTEM_MODE=desktop-local this defaults to false (no-op).
# When GALAXY_SYSTEM_MODE=desktop-cross-device this defaults to true.
# Setting GALAXY_NATS_URL also implicitly enables NATS regardless of mode.
GALAXY_NATS_ENABLED=false                 # false | true
# e.g. nats://localhost:4222
GALAXY_NATS_URL=
# Launcher post-start health: if NATS TCP is closed, that is warning-only on
# desktop-local noop bus; set GALAXY_FABRIC_STRICT=true or GALAXY_NATS_ENABLED=true
# to treat unreachable NATS as a failed check.

# Fabric strict mode — when true, missing fabric dependencies (e.g. NATS
# not reachable) cause a hard startup failure instead of graceful degradation.
# Only meaningful when GALAXY_NATS_ENABLED=true.
GALAXY_FABRIC_STRICT=false                # false | true

# Network topology mode.
GALAXY_NETWORK_MODE=local                 # local | lan | tailscale | relay

# Cross-device routing switch (also consumed by galaxy_gateway).
# Derived from GALAXY_SYSTEM_MODE when not set explicitly.
GALAXY_CROSS_DEVICE_ENABLED=false         # false | true

# Transport priority: comma-separated ordered list.
# Defaults: lan,internet (desktop-local)  or  tailscale,lan,internet (cross-device).
# e.g. tailscale,lan,internet
GALAXY_TRANSPORT_PRIORITY=

# ============================================================================
# Runtime Mode
# ============================================================================
GALAXY_MODE=production          # production | development | testing
GALAXY_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# ============================================================================
# LLM API Keys (at least one required)
# ============================================================================
# V2 最小可操作路径：建议至少配置 1 个 key，否则
# /api/v1/projection/operability-contract 会提示 env 降级诊断。
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_OCR2_API_KEY=your_deepseek_ocr2_api_key_here
XAI_API_KEY=your_xai_api_key_here
META_API_KEY=your_meta_api_key_here          # Meta Model API (Muse Spark), https://developer.meta.com/ai
MISTRAL_API_KEY=your_mistral_api_key_here
MOONSHOT_API_KEY=your_moonshot_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ============================================================================
# General LLM (used by scheduler / ReAct engine)
# ============================================================================
LLM_API_KEY=your_llm_api_key_here

# 本地 Ollama 主脑模型（Local Ollama main-brain model）
# 【留空】=> 首次启动会在「AI 大脑」阶段【交互式让你选择】主脑，候选:
#     [1] Google Gemma 4 12B        文本+视觉+原生音频(听)+工具调用, 128K
#     [2] MiniCPM-o 4.5 (9B)        全模态: 看+听+说, 全双工(需显卡)
#     [3] Google Gemma 4 E4B        文本+视觉+原生音频, 中等显存
#     [4] Google Gemma 4 E2B        文本+视觉+原生音频, 小显存/轻量(纯 CPU 推荐)
#   会按你的【实际显存】高亮推荐，回车用推荐 / 数字手选 / s 跳过。
# 若在此【显式指定】一个 tag（如 gemma4:e2b），则跳过交互、直接用它。
# 之后随时可用  python main.py --select-model  重新选择。
OLLAMA_MODEL=

# Memory system persistent storage path
# Default: /app/data/ (Docker volume) or ./data/ (local dev)
MEMORY_DB_PATH=/app/data/galaxy_memory.db

# 统一记忆层 (core/memory) — 语义/跨模态长程记忆后端，逗号分隔。
# "vector" = 复用内置向量后端(Chroma/Qdrant，自动降级本地，零依赖默认可用)。
# "omni"   = SimpleMem 文本终身记忆(`pip install simplemem` + 下面的 key)。
#            注意：PyPI 的 simplemem 是【纯文本】，不是多模态 Omni-SimpleMem(未发布到 PyPI)。
# "clip"   = 真·跨模态(CLIP 文↔图)：用一句话召回相关画面(摄像头帧)。
#            需 `pip install sentence-transformers pillow chromadb`(首次下 ~600MB)。
# "clap"   = 真·跨模态(CLAP 文↔音)：用一句话召回相关声音片段(麦克风)。
#            需 `pip install transformers chromadb librosa`(+ ffmpeg 解码 webm；首次下权重)。
GALAXY_MEMORY_BACKENDS=vector            # 例: vector | vector,clip,clap | vector,clip,clap,omni
GALAXY_CLIP_MODEL=clip-ViT-B-32          # CLIP 模型(sentence-transformers)
GALAXY_CLIP_DIR=./data/clip_memory       # CLIP 图像记忆持久化目录
GALAXY_CLAP_MODEL=laion/clap-htsat-unfused  # CLAP 模型(transformers)
GALAXY_CLAP_DIR=./data/clap_memory       # CLAP 音频记忆持久化目录
# SimpleMem 用的 OpenAI 兼容 key(留空=该后端不启用)
GALAXY_SIMPLEMEM_API_KEY=
GALAXY_SIMPLEMEM_MODEL=gpt-4o-mini
GALAXY_SIMPLEMEM_BASE_URL=
# 向量后端选择(被 "vector" 使用): auto | local | chroma | qdrant
# auto = 优先 chroma 真语义(需 pip install chromadb)，未装则自动退化 local 关键词。
KB_VECTOR_BACKEND=auto
# 文本嵌入模型(chroma)。默认多语言模型,显著改善中英文跨语言召回(eval 实测默认
# all-MiniLM 偏英文、跨语言仅 ~50% recall@1)。首次下 ~470MB(HF);下不动则自动
# 回退 chroma 默认 all-MiniLM(不崩)。设 "" 或 "default" 直接用 all-MiniLM。
GALAXY_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# HuggingFace 国内镜像：模型(嵌入器/CLIP/CLAP)下载走 hf-mirror.com，国内可达。
# install.sh 会在克隆/安装阶段预下载这些模型(scripts/predownload_models.py)，首次运行无需等。
# 设 GALAXY_HF_MIRROR=0 用 HuggingFace 官方域名；GALAXY_HF_ENDPOINT 可指向自建镜像。
GALAXY_HF_MIRROR=1
GALAXY_HF_ENDPOINT=https://hf-mirror.com
HF_ENDPOINT=https://hf-mirror.com
# pip 安装换源(被 install.sh 读取)：默认清华镜像；设 "default" 用官方 PyPI。
GALAXY_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
GALAXY_OMNIMEM_DIR=./data/omni_simplemem  # Omni-SimpleMem 持久化目录
# 跨模态记忆：用户开口时把桌面摄像头/麦克风快照也写进记忆(绑定到该轮对话)。
# 默认关闭(媒体摄入较重，尤其 omni 后端)；需同时启用桌面感知(GALAXY_DESKTOP_PERCEPTION=1)。
GALAXY_MEMORY_MEDIA=0

# OneAPI gateway (optional, for enhancements/coding)
ONEAPI_BASE_URL=http://localhost:3000/v1

# ============================================================================
# Security
# ============================================================================
# Clone-to-use (local dev): leave GALAXY_AUTH_ENABLED=false — preflight treats a
# missing GALAXY_API_TOKEN as WARNING, not CRITICAL.
# Production: set GALAXY_AUTH_ENABLED=true and set a strong GALAXY_API_TOKEN.
# Optional staging hardening: GALAXY_REQUIRE_API_TOKEN=true forces CRITICAL
# preflight on missing token even when Bearer middleware is still disabled.
GALAXY_API_TOKEN=your_galaxy_api_token_here

# Enable Bearer token enforcement on all REST + WebSocket endpoints.
# Default: false (disabled) — set to true in production with GALAXY_API_TOKEN.
# When enabled, requests without a valid Authorization: Bearer <token> header
# (or ?token=<token> query param for WebSocket) receive HTTP 401.
GALAXY_AUTH_ENABLED=false
GALAXY_REQUIRE_API_TOKEN=false           # true | false — see notes above

# TLS/HTTPS for the gateway server.
# Both cert and key must be set to enable HTTPS; otherwise plain HTTP is used.
# Paths are relative to the working directory or absolute.
# e.g. /etc/ssl/certs/galaxy.crt
GALAXY_TLS_CERT=
# e.g. /etc/ssl/private/galaxy.key
GALAXY_TLS_KEY=

# Pickle serialization secret (external/memos)
PICKLE_SECRET_KEY=your_secure_random_secret_key_here

# ============================================================================
# Eval Scripts (external/agentcpm)
# ============================================================================
EVAL_API_KEY=your_eval_api_key_here

# ============================================================================
# Memos Module
# ============================================================================
MEMOS_API_KEY=your_memos_api_key_here
MEMOS_OPENAI_API_KEY=your_openai_api_key_here
MEMOS_OPENAI_API_BASE=https://api.openai.com/v1

# ============================================================================
# DingTalk (optional — notifications)
# ============================================================================
DINGDING_APP_KEY=
DINGDING_APP_SECRET=
DINGDING_ACCESS_TOKEN_USER=
DINGDING_SECRET_USER=
DINGDING_ACCESS_TOKEN_ERROR=
DINGDING_SECRET_ERROR=

# ============================================================================
# Databases
# ============================================================================
NEBULA_PASSWORD=
POLARDB_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
MEMSCHEDULER_REDIS_PASSWORD=

# ============================================================================
# Infrastructure Credentials — docker-compose.full.yml
# ============================================================================
# PRODUCTION REQUIREMENT: Every password/secret below must be set to a strong,
# unique value before deploying to any non-local environment.
# The placeholder value "change_me_before_production" must NOT be used in
# staging or production — it exists only to make missing values obvious.
#
# Copy this file and fill in real values:  cp .env.example .env
# Never commit a populated .env file to version control.
# ----------------------------------------------------------------------------

# Neo4j graph database (username is always "neo4j")
NEO4J_PASSWORD=change_me_before_production

# MongoDB root credentials
MONGO_ROOT_USERNAME=mongoadmin
MONGO_ROOT_PASSWORD=change_me_before_production

# Temporal workflow engine — PostgreSQL backend credentials
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=change_me_before_production

# OneAPI gateway session secret (use a long random string in production)
ONEAPI_SESSION_SECRET=change_me_before_production

# MinIO object storage credentials
MINIO_ROOT_USER=galaxy_admin
MINIO_ROOT_PASSWORD=change_me_before_production

# ============================================================================
# Monitoring (docker-compose.production.yml)
# ============================================================================
GRAFANA_ADMIN_PASSWORD=change_me_before_production

# ============================================================================
# Vector Knowledge Base Backend
# ============================================================================
# Choose the vector engine for knowledge base retrieval.
# Supported values: local (default) | chroma | qdrant
# Falls back to "local" (keyword search) automatically if the chosen backend
# is unavailable (not installed / not reachable).
KB_VECTOR_BACKEND=local

# Qdrant vector database URL (only used when KB_VECTOR_BACKEND=qdrant)
# Example: http://localhost:6333
QDRANT_URL=

# ChromaDB persistent storage directory (only used when KB_VECTOR_BACKEND=chroma)
# Default: ./chroma_db
CHROMA_PERSIST_DIR=./chroma_db

# Shared vector collection/index name (default: ufo_galaxy_knowledge)
KB_COLLECTION=ufo_galaxy_knowledge

# Embedding vector dimension — must match the model used (default: 384)
KB_VECTOR_SIZE=384

# ============================================================================
# Additional LLM Providers (optional)
# ============================================================================
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
ZHIPU_API_KEY=
QWEN_API_KEY=
BOCHA_API_KEY=

# ============================================================================
# Local LLM (optional)
# ============================================================================
# e.g. http://localhost:11434
OLLAMA_URL=
# e.g. http://localhost:8000/v1
VLLM_API_BASE=
VLLM_API_KEY=

# ============================================================================
# LLM Model Selection (optional)
# ============================================================================
# Default model for general tasks
DEFAULT_MODEL=
# Model for code generation
CODE_MODEL=
# Model for simple queries
SIMPLE_MODEL=
# Model for complex reasoning
COMPLEX_MODEL=

# ============================================================================
# Server & Network
# ============================================================================
HOST=0.0.0.0                            # Server bind host
PORT=9000                               # Server bind port (unified: WS + REST + WebRTC proxy on same port)
API_HOST=0.0.0.0
API_PORT=9000                           # Same as PORT — all services run in the same process on port 9000
WEB_UI_PORT=8085                        # Unified Dashboard port (Galaxy unified launcher)

# --- Desktop Perception (摄像头/麦克风/屏幕 连续感知, 默认关闭/隐私优先) ---
# 开启后 Electron 壳会用 getUserMedia 周期采集摄像头(+麦克风)帧, POST 到
# /api/perception/desktop/* ; 模型在下一次普通请求时按 TTL 取用(原生看到画面)。
GALAXY_DESKTOP_PERCEPTION=0                  # 1/true 启用桌面摄像头+麦克风采集
GALAXY_DESKTOP_PERCEPTION_INTERVAL_MS=2000   # 采集间隔(毫秒)
GALAXY_DESKTOP_PERCEPTION_TTL=10             # 后端帧新鲜度 TTL(秒); 超时不注入
# 三仓打通：把 Android 经 WS 上行的 DEVICE_PERCEPTION_EMISSION(视觉/grounding/截图)
# 喂进统一/跨模态记忆，使手机感知可被桌面大脑召回。默认开;置 0 关闭。
# 截图入跨模态记忆还需 GALAXY_MEMORY_MEDIA=1。
GALAXY_ANDROID_PERCEPTION_INGEST=1
# 人在回路(HITL)高风险动作确认门：开启后,破坏性/高风险设备命令(delete/format/
# shutdown/sudo/payment 等)在执行前必须经人类确认(手表/手机决策通知→human_input)。
# 默认关闭;开启则 fail-closed —— 超时/无设备/拒绝都不执行。确认超时见下。
GALAXY_HITL_CONFIRM_GATE=0
GALAXY_HITL_CONFIRM_TIMEOUT_S=60        # 高风险确认等待秒数(默认 60;到点按保守取消)
# 普通对话自动「听见」麦克风：用音频模型原生听懂最新麦克风音频→转写注入 prompt。
# 默认关闭(每次新音频会多一次音频模型调用); 需配置 GEMINI/GOOGLE 或 OPENAI key。
GALAXY_DESKTOP_AUDIO_AUTOINJECT=0

# CORS allowed origins (comma-separated)
# Default: http://localhost:3000,http://localhost:8085,http://localhost:9000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8085,http://localhost:9000

# ============================================================================
# Database URLs
# ============================================================================
# Main database connection string
DATABASE_URL=
# Redis connection URL (e.g. redis://localhost:6379)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL (if using Node_12_Postgres)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ============================================================================
# WebRTC / ICE connectivity (optional)
# ============================================================================
# Comma-separated STUN server URLs exposed via /api/v1/webrtc/endpoint
# e.g. stun:stun.l.google.com:19302
GALAXY_STUN_URLS=

# Comma-separated TURN server URLs exposed via /api/v1/webrtc/endpoint
# e.g. turn:turn.example.com:3478
GALAXY_TURN_URLS=
# TURN credential username
GALAXY_TURN_USERNAME=
# TURN credential password
GALAXY_TURN_CREDENTIAL=

# Tailscale — set to true when this gateway node is on a Tailscale tailnet
GALAXY_TAILSCALE_ENABLED=false
# e.g. galaxy-gateway.example-tailnet.ts.net
GALAXY_TAILSCALE_HOST=
# e.g. tag:galaxy-gateway
GALAXY_TAILSCALE_TAG=

# ============================================================================
# Node Service URLs (optional — for remote node communication)
# ============================================================================
NODE_09_SANDBOX_URL=                    # Code sandbox service
NODE_33_URL=                            # ADB service
NODE_34_URL=                            # Scrcpy service
NODE_41_URL=                            # MQTT service
NODE_45_URL=                            # Desktop Automation
NODE_71_URL=                            # Multi-Device Coordination
NODE_92_URL=                            # Auto Control
NODE_95_URL=                            # WebRTC Receiver
MEMORY_SERVICE_URL=http://localhost:8100
CODE_SERVICE_URL=http://localhost:8101

# ============================================================================
# Federation (optional — multi-instance deployment)
# ============================================================================
FEDERATION_ENABLED=false
FEDERATION_LOCAL_HOST=
# Comma-separated peer URLs
FEDERATION_PEERS=

# ============================================================================
# Concurrency & Performance
# ============================================================================
CONCURRENCY_GLOBAL_MAX=50
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# External Services (optional)
# ============================================================================
# GitHub personal access token (raises rate limit to 5000/h)
GITHUB_TOKEN=
BRAVE_API_KEY=
OPENWEATHERMAP_API_KEY=

# ============================================================================
# GitHub MCP/Skill Auto-Installer (optional)
# ============================================================================
# Personal access token for cloning and downloading GitHub repos.
# Without this, anonymous access is used (60 req/h rate limit).
# NEVER paste your token into chat — set it here or via the Dashboard config page.
# GITHUB_TOKEN=ghp_...                  # Same as above; re-stated for visibility

# Override the default install directory (default: data/github_addons/)
# GITHUB_INSTALL_DIR=./data/github_addons

# Allowlist: comma-separated owner/repo glob patterns that are permitted.
# Leave empty to allow all repositories.
# GITHUB_ALLOWLIST=myorg/*,trusted-user/mcp-*

# Blocklist: comma-separated owner/repo glob patterns that are blocked.
# Applied after allowlist check.  Leave empty to block nothing.
# GITHUB_BLOCKLIST=

# ============================================================================
# Intent Parser
# ============================================================================
# Set to "true" to use the modern IntentParser (rules + LLM) in the dashboard.
# When disabled or unset, the dashboard falls back to basic keyword matching.
USE_MODERN_INTENT_PARSER=true

# ============================================================================
# Plugins
# ============================================================================
# Directory used by Node_28/29/31/32 for plugin loading.
GALAXY_PLUGIN_DIR=./plugins

# ============================================================================
# PixVerse Media Generation (Node_125)
# ============================================================================
PIXVERSE_DOWNLOAD_DIR=./downloads
PIXVERSE_MAX_WAIT=300               # Max seconds to wait for video generation
PIXVERSE_POLL_INTERVAL=5            # Seconds between status polls

# ============================================================================
# Custom Logger
# ============================================================================
CUSTOM_LOGGER_TOKEN=

# ============================================================================
# OpenClawd Agent Heartbeat (see config/agent.yaml for full config)
# ============================================================================
# Override heartbeat enabled flag at runtime (true/false).
# When unset, the value from config/agent.yaml is used.
# HEARTBEAT_ENABLED=true

# Override heartbeat interval at runtime (e.g. 30m, 1h, 90s).
# When unset, the value from config/agent.yaml is used.
# HEARTBEAT_INTERVAL=30m
